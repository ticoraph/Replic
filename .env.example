# --- Base de données (pgvector local via docker/docker-compose.yml) ---
DATABASE_URL=postgresql://pulpfiction:pulpfiction@localhost:5434/pulpfictionchatbot

# --- Hugging Face (base Llama gated + push adapter privé) ---
HF_TOKEN=

# --- Weights & Biases (tracking training / éval) ---
WANDB_API_KEY=
WANDB_PROJECT=pulpfictionchatbot

# --- Modal (inférence GPU serverless vLLM) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# URL de l'endpoint OpenAI-compatible déployé sur Modal (rempli après `modal deploy`)
MODAL_INFERENCE_URL=
MODAL_INFERENCE_API_KEY=

# --- LLM distant : traduction, augmentation et juges ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- API backend ---
API_KEY=change-me
CORS_ORIGINS=http://localhost:5173,https://pulpfiction.fr
